[Unit]
Description=container-mesh member (joins with a team credential)
Wants=network-online.target
After=network-online.target

# ★ THE START LIMIT BELONGS TO [Unit], NOT TO [Service].
#
# It used to sit in [Service], and systemd has NO Service.StartLimit*
# alias — so it was silently IGNORED:
#
#   systemd-analyze verify cmesh-member.service
#   cmesh-member.service:172: Unknown key name 'StartLimitIntervalSec'
#   in section 'Service', ignoring.
#   systemctl show -p StartLimitIntervalUSec  →  10s   (the default, not 60s)
#
# Measured on real systemd 255 with ExecStart=/bin/false, RestartSec=5s:
#   in [Service]  → NRestarts=18 after 95s, STILL looping
#   in [Unit]     → NRestarts=5, then ActiveState=failed (stopped)
#
# The comment's arithmetic was right; the SECTION made it inert.
# StartLimitIntervalSec / StartLimitBurst are [Unit] directives.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=cmesh
Group=cmesh

# ★ WHERE THE LOGS GO: THE JOURNAL, STATED EXPLICITLY.
#
# systemd's default for a system service IS the journal, so this unit
# would log there anyway. The default is a MANAGER-wide setting
# (DefaultStandardOutput / DefaultStandardError in systemd/system.conf),
# though — and a machine that hardens those to "null" throws the
# service's diagnostics away with no error anywhere.
#
# Stating it here makes the unit immune to that, and it answers the
# operator's first question ("where do the logs go") without a guess.
#
# ★ THE JOURNAL ROTATES ON ITS OWN.
#
# journald's SystemMaxUse (default: 10% of the filesystem, capped at
# 4 GiB) bounds the journal's size, so there is no logrotate job to
# write and no rotated file to find. The operator reads the log with:
#
#	journalctl -u cmesh-member.service -f
#
# ★ SyslogIdentifier IS THE STABLE TAG.
#
# Without it the entries are filed under whatever the process called
# itself, so `journalctl -t cmesh` finds nothing and the operator has
# to know the unit's name to look at all. With it the tag is the same
# on every host and every version of this unit.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cmesh-member

# The environment file is NOT optional. The leading "-" would let systemd
# start the unit with every variable empty, and an empty ${CMESH_STATE}
# then reaches the CLI as an empty --state, which silently falls back to
# ~/.cmesh -- a path the hardening below makes read-only, and the wrong
# place for the node's state anyway. A missing file must fail loudly.
#
# Measured on a real Linux systemd host: with a missing EnvironmentFile
# the unit fails with Result=resources and
# "Failed to load environment files: No such file or directory".
EnvironmentFile=/etc/cmesh/member.env

# The private-deployment switch.
#
# A private or loopback discovery address is REFUSED by default — the
# egress policy exists so a hostile member cannot steer the others at a
# private address. But a deployment whose anchor is on a private network
# (or the same host) legitimately needs it, and a service has no
# interactive way to turn it on: the operator would have to put it in the
# environment file, where it is easy to miss.
#
# It is an Environment= line (not part of the operator's file) so the
# switch is visible in the unit and not something an operator has to
# know about. Set it to 0 (or comment it out) for a public deployment.
Environment=CMESH_ALLOW_PRIVATE_DISCOVERY=1

# The member gets its OWN state directory. It must not share one with the
# anchor (cmesh-discovery.service).
#
# StateDirectory=cmesh maps to /var/lib/cmesh, and the anchor already
# claims exactly that name. Two units naming the same StateDirectory
# share ONE directory, so the member's device identity (device.json, the
# private key) and its inbox would land inside the directory the anchor
# service also owns and writes to. That is a shared blast radius for two
# different trust domains, for no reason.
#
# The member's state holds a DEVICE PRIVATE KEY and the credential
# material, so the directory is 0700 rather than the anchor's 0750: the
# anchor's directory is readable by the cmesh group for the operator's
# convenience, the member's is not.
#
# Measured on a real Linux systemd host: StateDirectory=cmesh-member
# StateDirectoryMode=0700 with User=cmesh Group=cmesh yields
# "700 cmesh:cmesh /var/lib/cmesh-member", while the anchor's
# /var/lib/cmesh is "750 cmesh:cmesh". They are different directories.
StateDirectory=cmesh-member
StateDirectoryMode=0700

# The TEAM CREDENTIAL is the authority to join: whoever holds it can mint a
# device certificate under the account. It is the most sensitive secret this
# project has -- more so than the panel token, which only opens the roster
# for reading.
#
# Do not put it on the command line. A command line is visible to every
# local user through /proc/<pid>/cmdline. Do not put it in the
# environment file either: EnvironmentFile variables DO land in the
# service's environ, where every process running as the same user (the
# service's own children included) can read them.
#
# LoadCredential gives the service a private copy of a root-owned file
# (mode 0600), readable by the service's process and by nobody else. Put
# the credential in /etc/cmesh/cred and point LoadCredential at it; the
# CLI reads it with --cred-file.
#
# The credential is MANDATORY here, and the unit says so on purpose. The
# no-"-" prefix on LoadCredential= is what makes it mandatory: a missing
# /etc/cmesh/cred makes the unit FAIL TO START before ExecStart ever
# runs. That is the correct behaviour for the member -- it cannot join
# without the credential, and a member that starts without one and then
# retries forever is a much worse failure than a unit that refuses to
# start with a clear error. (The anchor's panel token is the same story:
# a node whose panel token file is missing must not come up.)
#
# NOTE on the "-" prefix, MEASURED on the real systemd host (175,
# systemd 255): a missing credential fails the unit with
# "Failed to set up credentials" and status 243/CREDENTIALS -- and where
# the dash stands decides WHERE it may go, not whether the file is
# required:
#
#   LoadCredential=cred:/etc/cmesh/missing   -> FAILS (243, measured)
#   LoadCredential=-cred:/etc/cmesh/missing  -> FAILS (243, measured):
#       the dash becomes part of the NAME; it does NOT make the file optional
#   LoadCredential=cred:-/etc/cmesh/missing  -> STARTS (measured,
#       Result=success): the dash before the PATH is what makes the file
#       optional
#
# The unit deliberately does NOT use the dash-before-path form: the member
# cannot join without the credential, and starting without one to retry
# forever is a worse failure than refusing to start with a clear error.
# (The anchor's panel token is the same story: a node whose panel token
# file is missing must not come up.)
#
# Measured on the real machine: with the credential on the command line, ps
# printed the whole credential string.
LoadCredential=cred:/etc/cmesh/cred
ExecStart=/opt/container-mesh/current/cmesh join --state ${CMESH_STATE} --cred-file ${CREDENTIALS_DIRECTORY}/cred --listen ${CMESH_LISTEN} --relay-trunk ${CMESH_RELAY_TRUNK} --relay-trunk-id ${CMESH_RELAY_TRUNK_ID}

# The relay trunk is OPTIONAL for the CLI and MANDATORY for the
# deployment, and those are different things, so the unit checks it
# itself.
#
# Why the check is here: the CLI treats --relay-trunk as "if this is
# non-empty, join that trunk". An EMPTY --relay-trunk makes the CLI skip
# the whole relay-trunk block silently (verified against the real binary
# and against the flag definitions in internal/cli/discovery.go runJoin).
# The member then comes up healthy and stays healthy forever, and it is
# pure-outbound: it can dial the anchor, but nothing can reach it back.
# That is exactly the failure the trunk exists to prevent, and it is
# invisible -- no error, no failed start, just a member that is never
# reachable. A pure-outbound member is a valid configuration, so this
# unit cannot simply require the trunk; it has to be loud about it.
#
# The check reads the SAME two variables the CLI reads, so what is
# validated is exactly what is used.
#
# It used not to: ExecStart passed the trunk through a THIRD variable
# ($CMESH_TRUNK_ARGS), so the guard validated two variables that the
# command line never mentioned, and an operator who followed the example
# file got a member that passed the guard and was still pure-outbound —
# exactly the failure the guard exists to prevent. Measured on a real
# host: cmdline had NO --relay-trunk, the anchor saw the member with
# endpoints=[] (unreachable), and the guard was happy. ExecStart now
# expands the two variables directly.
#
# "$$" is systemd's escape for a literal dollar sign: without it systemd
# would expand ${CMESH_RELAY_TRUNK} ITSELF (to the empty string) before
# /bin/sh ever sees it, and the shell would test the wrong thing.
# Measured on a real Linux systemd host: with CMESH_RELAY_TRUNK empty in
# the environment file, the guard below prints
# "cmesh-member: CMESH_RELAY_TRUNK is not set" and the unit fails with
# Result=exit-code, status=1/FAILURE.
# An ExecCONDITION, not an ExecStartPre.
#
# ExecStartPre's failure is a start failure, and Restart=on-failure
# covers it — so a member configured without a trunk retried every five
# seconds FOREVER (measured: four restarts in sixteen seconds, three
# guard messages). A precondition is a different thing: systemd does not
# restart the unit when a condition fails, so the refusal is stable and
# the operator sees it once, with the reason, instead of a machine that
# screams every five seconds.
ExecCondition=/bin/sh -c 'if [ -z "$${CMESH_RELAY_TRUNK}" ] || [ -z "$${CMESH_RELAY_TRUNK_ID}" ]; then echo "cmesh-member: CMESH_RELAY_TRUNK and CMESH_RELAY_TRUNK_ID must both be set: without a relay trunk this member is pure-outbound and can never RECEIVE a relayed session (see the member env example)" >&2; exit 1; fi'

# ★ THE STATE DIRECTORY IS A PRECONDITION TOO.
#
# The member's state holds a DEVICE PRIVATE KEY and the credential
# material, so it must be its OWN directory — this unit declares
# StateDirectory=cmesh-member and makes /var/lib/cmesh-member writable
# and nothing else.
#
# With an empty CMESH_STATE the CLI does NOT fail: it falls back to
# ~/.cmesh, which for this unit is the ANCHOR's directory (the member
# user's home is /var/lib/cmesh). And that directory is read-only under
# this unit's hardening. Measured on a real host:
#
#	mkdir /var/lib/cmesh/member: read-only file system
#
# …and then a restart loop. So the failure is real, it is measurable,
# and it names a directory the operator never configured — which is the
# worst way for it to fail.
#
# The same class of failure the state directory is meant to prevent:
# the member's device identity landing in the anchor's trust domain.
#
# A separate ExecCondition, because it is a separate fact: multiple
# ExecCondition lines are ANDed (measured on real systemd 249 — with the
# second one failing, the ExecStart never ran).
ExecCondition=/bin/sh -c 'if [ -z "$${CMESH_STATE}" ]; then echo "cmesh-member: CMESH_STATE is not set; it must name the member'"'"'s OWN state directory (/var/lib/cmesh-member), because an empty value silently falls back to ~/.cmesh — the ANCHOR'"'"'s directory, which this unit makes read-only, and the member'"'"'s device private key would land in the wrong trust domain" >&2; exit 1; fi'


Restart=on-failure
RestartSec=5s

# THE START LIMIT, EXPLICITLY — the same arithmetic as the anchor's unit.
#
# systemd's defaults are a burst of 5 starts in a 10-second interval.
# With RestartSec=5s the starts land at 0, 5, 10 … so any 10-second
# window holds at most 3, and the burst of 5 is UNREACHABLE — a broken
# configuration then restarts forever instead of stopping where an
# operator can see it.
#
# The window has to be longer than RestartSec * (Burst - 1) = 20
# seconds for the burst to be reachable at all. 60 seconds gives room
# for 12 starts.
#
# The ExecCondition above already refuses a misconfigured member
# WITHOUT restarting it — but every OTHER failure path (an empty
# passphrase, an unreadable credential, a read-only state directory)
# still exits non-zero, and this is what stops those from looping.
#
# ★ The directives themselves are in [Unit] above — they are [Unit]
# directives, and in [Service] systemd ignores them.

# The member announces its own departure on SIGTERM, so the anchor and the
# other members see it go. Give that broadcast a moment to leave.
KillSignal=SIGTERM
TimeoutStopSec=15s

UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# StateDirectory= above already excludes /var/lib/cmesh-member from
# ProtectSystem=strict, so this line is belt and braces: it names the
# member's OWN directory, not the anchor's.
ReadWritePaths=/var/lib/cmesh-member

[Install]
WantedBy=multi-user.target
