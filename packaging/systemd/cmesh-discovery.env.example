# Copy to /etc/cmesh/discovery.env and populate values through the approved
# read-only environment or secret service. No real credential belongs here.
CMESH_STATE=/var/lib/cmesh
CMESH_ADDR=:8080
CMESH_ANNOUNCE=127.0.0.1:8080

# The account public key. This one is NOT a secret: `cmesh account show`
# prints it. It is required, because without --account-pub the discovery
# node does not mount the enrollment endpoint at all and a member cannot
# join with a team credential. Copy the value printed by:
#
#   cmesh account show --state /var/lib/cmesh
#
CMESH_ACCOUNT_PUB=

# The CLI reads this value without printing it. Leave empty only when an
# interactive tty will provide the passphrase before starting the service.
#
# A service has no tty: an empty passphrase makes the CLI read EOF and
# exit. Inject the value here through the operator's secret process, or
# use a credential helper that answers the prompt.
CMESH_PASSPHRASE=
