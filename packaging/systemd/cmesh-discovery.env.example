# Copy to /etc/cmesh/discovery.env and populate values through the approved
# read-only environment or secret service. No real credential belongs here.
CMESH_STATE=/var/lib/cmesh
CMESH_ADDR=:8080
CMESH_ANNOUNCE=127.0.0.1:8080
# The CLI reads this value without printing it. Leave empty only when an
# interactive tty will provide the passphrase before starting the service.
CMESH_PASSPHRASE=
