# container-mesh member (systemd)
#
# Copy to /etc/cmesh/member.env, fill in the values, then:
#   sudo install -d -m 0750 -o root -g cmesh /etc/cmesh
#   sudo install -m 0600 -o root -g cmesh /path/to/credential /etc/cmesh/cred
#   sudo chmod 0640 -o root -g cmesh /etc/cmesh/member.env
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cmesh-member.service
#
# CMESH_PASSPHRASE is load-bearing: a service has no tty, so an empty
# passphrase makes the CLI read EOF and exit.
#
# The state directory must be the member's OWN. The unit declares
# StateDirectory=cmesh-member and hardens the file system with
# ReadWritePaths=/var/lib/cmesh-member — so pointing the state at the
# ANCHOR's directory puts it where the unit has made read-only, and the
# member cannot even write its own device identity. Measured on a real
# host: "mkdir /var/lib/cmesh/member: read-only file system", then a
# restart loop.
CMESH_STATE=/var/lib/cmesh-member
#
# The port must NOT be the anchor's. The anchor's example uses 18090,
# and a member configured with the same port cannot bind it
# ("address already in use"). Give the member its own.
CMESH_LISTEN=0.0.0.0:18101
CMESH_PASSPHRASE=change-me

# The relay trunk this member attaches to, so it can RECEIVE relayed
# sessions (a pure-outbound member is otherwise unreachable).
#
# The unit's ExecStart expands these two variables directly into
# --relay-trunk and --relay-trunk-id, and its guard checks these same
# two — so what is validated is exactly what is used. (An earlier
# version passed them through a third variable, and a member built from
# this file passed the guard while never being given a trunk at all.)
#
# The trunk's ADDRESS is the one the MEMBER can reach, and the ID is the
# TRUNK's device ID (`cmesh account show` on the anchor prints it) — not
# the account ID. Passing the account ID fails with "authentication
# failed: … is not in the current view".
CMESH_RELAY_TRUNK=host:port
CMESH_RELAY_TRUNK_ID=device-id-of-the-trunk

# NOT here: the team credential. It belongs in /etc/cmesh/cred, handed
# over by systemd's LoadCredential — an EnvironmentFile variable would
# land in the service's environ, readable by every same-uid process.
#
# Nor the panel token: that is the anchor's, not the member's.
